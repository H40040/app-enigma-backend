# Configurações do servidor
PORT=4006
NODE_ENV=development

# Segurança - IMPORTANTE: Gere chaves seguras para produção
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" para gerar
JWT_SECRET=your_super_secure_jwt_secret_here_minimum_32_characters
REFRESH_TOKEN_SECRET=your_super_secure_refresh_token_secret_here_minimum_32_characters
TOKEN_EXPIRATION=1h
REFRESH_TOKEN_EXPIRATION=7d
COOKIE_SECRET=your_super_secure_cookie_secret_here_minimum_32_characters

# URLs
FRONTEND_URL=http://localhost:8080
API_URL=http://localhost:4006/api
SERVER_IP=192.168.1.91

# Banco de dados
# Para desenvolvimento (SQLite)
DATABASE_URL="file:../prisma/dev.db"

# Para produção (PostgreSQL) - descomente e configure
# DATABASE_URL="postgresql://username:password@localhost:5432/enigmacrush?schema=public"

# APIs externas (se necessário)
# API_GRATIS_TOKEN=your_api_gratis_token_here

# Configurações de email (se implementado)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Configurações de upload
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp

# Configurações de rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
PASSWORD_CHANGE_RATE_LIMIT_MAX=3

# Configurações de sessão
SESSION_TIMEOUT_MS=3600000
INACTIVE_SESSION_THRESHOLD_MS=3600000

# Configurações de log
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
AUDIT_LOG_ENABLED=true

# Configurações de CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Configurações de produção
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/key.pem
# REDIS_URL=redis://localhost:6379
# SENTRY_DSN=your_sentry_dsn_here
