# Configuração para ambiente de teste
NODE_ENV=test

# Database - SQLite em memória para testes
DATABASE_URL="postgresql://user:password@localhost:5432/test_enigmacrush?schema=public"

# JWT
JWT_SECRET=test_jwt_secret_key_for_testing_only
JWT_EXPIRES_IN=1h

API_GRATIS_TOKEN=test_token
API_GRATIS_BASE_URL=https://api.test.com
SKIP_API_VALIDATION=false

# Rate Limiting (mais permissivo para testes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logs
LOG_LEVEL=error

# Porta para testes
PORT=3001