# Production Environment Configuration
# Copy this file to .env and update with your production values

# Server Configuration
NODE_ENV=production
PORT=4006
SERVER_IP=0.0.0.0

# Security Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_super_secure_jwt_secret_256_bits_minimum
REFRESH_TOKEN_SECRET=your_super_secure_refresh_token_secret_256_bits
COOKIE_SECRET=your_super_secure_cookie_secret_256_bits
TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# URLs
FRONTEND_URL=https://app-enigma-frontend-git-develop-h40040s-projects.vercel.app
API_URL=https://api.yourdomain.com

# Database Configuration (PostgreSQL for production)
DATABASE_URL=postgresql://enigma_user:secure_password@postgres:5432/enigma_crush?schema=public
POSTGRES_DB=enigma_crush
POSTGRES_USER=enigma_user
POSTGRES_PASSWORD=secure_password_change_me

# Redis Configuration
REDIS_URL=redis://:redis_password@redis:6379
REDIS_PASSWORD=redis_password_change_me

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# Session Configuration
SESSION_SECRET=your_session_secret_change_me
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=combined
AUDIT_LOG_ENABLED=true

# CORS Configuration
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL Configuration (if using HTTPS directly in Node.js)
SSL_ENABLED=false
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production

# Email Configuration (if needed)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_password

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Performance Monitoring
PERFORMACE_MONITORING=true
MEMORY_THRESHOLD=80
CPU_THRESHOLD=70

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30