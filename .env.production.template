# Enigma Crush Backend - Production Environment Variables Template
# Copy this file to .env.production and fill in the actual values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=4006
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION (Supabase)
# =============================================================================
# Get from: https://supabase.com/dashboard/project/[project-id]/settings/database
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?schema=public&sslmode=require"

# Alternative format for connection pooling
# DATABASE_URL="postgresql://postgres.pooler:[password]@[project-ref]-pooler.supabase.com:6543/postgres?sslmode=require"

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get from: https://supabase.com/dashboard/project/[project-id]/settings/api
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secure-jwt-secret-key-here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Frontend URL (Vercel deployment)
CORS_ORIGIN="https://your-app.vercel.app"
# Multiple origins (comma-separated)
# CORS_ORIGIN="https://your-app.vercel.app,https://your-custom-domain.com"

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session configuration
SESSION_SECRET="your-session-secret-key-here"
SESSION_MAX_AGE=86400000

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP settings for email notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@enigmacrush.com"

# =============================================================================
# RENDER DEPLOYMENT CONFIGURATION
# =============================================================================
# These are set automatically by Render
# RENDER_SERVICE_ID="srv-..."
# RENDER_EXTERNAL_URL="https://your-service.onrender.com"

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL="info"
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_TRACKING=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_SWAGGER_DOCS=false
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_COMPRESSION=true

# =============================================================================
# CACHE CONFIGURATION (Optional)
# =============================================================================
# Redis URL for caching (if using Redis)
# REDIS_URL="redis://localhost:6379"
# CACHE_TTL=3600

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH="./uploads"
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp"

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_VERSION="v1"
API_PREFIX="/api"
MAX_REQUEST_SIZE="10mb"

# =============================================================================
# DEVELOPMENT/DEBUG (Set to false in production)
# =============================================================================
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_PLAYGROUND=false

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_ENDPOINT="/health"
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with real values to version control
# 2. Use strong, unique passwords and secrets
# 3. Rotate secrets regularly
# 4. Use environment-specific values for each deployment
# 5. Test all configurations in staging before production
# 6. Monitor logs for any configuration issues
# 7. Keep this template updated when adding new environment variables