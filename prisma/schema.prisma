// Schema Prisma - Suporte para SQLite (dev) e PostgreSQL (prod)
generator client {
  provider = "prisma-client-js"
}

// Configuração de seed
// Para executar: npx prisma db seed
// Ou: npm run db:seed

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  birthdate DateTime
  cpf       String    @unique
  whatsapp  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  lastLogin DateTime?
  isAdmin   Boolean   @default(false)
  admirers  Admirer[]

  @@map("users")
  @@index([email])
  @@index([cpf])
  @@index([createdAt])
}

model Admirer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hints     Hint[]
  createdAt DateTime @default(now())

  @@map("admirers")
  @@index([userId])
  @@index([createdAt])
}

model Hint {
  id           String        @id @default(cuid())
  content      String
  type         String        @default("text")
  views        Int           @default(0)
  interactions Int           @default(0)
  admirerId    String
  admirer      Admirer       @relation(fields: [admirerId], references: [id], onDelete: Cascade)
  interaction  Interaction[]
  createdAt    DateTime      @default(now())

  @@map("hints")
  @@index([admirerId])
  @@index([type])
  @@index([createdAt])
}

model Interaction {
  id         String    @id @default(cuid())
  content    String
  answer     String?
  hintId     String
  hint       Hint      @relation(fields: [hintId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  @@map("interactions")
  @@index([hintId])
  @@index([createdAt])
  @@index([answeredAt])
}

model Message {
  id                String   @id @default(cuid())
  senderId          String
  recipientId       String?
  recipientUsername String?
  recipientEmail    String?
  recipientPhone    String?
  contactMethod     String
  content           String
  imageUrl          String?
  createdAt         DateTime @default(now())
  isRead            Boolean  @default(false)
  views             Int      @default(0)
  replies           Reply[]

  @@map("messages")
  @@index([senderId])
  @@index([recipientId])
  @@index([recipientEmail])
  @@index([createdAt])
  @@index([isRead])
}

model Reply {
  id            String   @id @default(cuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime @default(now())
  fromRecipient Boolean  @default(false)

  @@map("replies")
  @@index([messageId])
  @@index([createdAt])
}

// Tabela para logs de auditoria
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ipAddress])
}

// Tabela para sessões de usuário
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  expiresAt    DateTime
  isActive     Boolean   @default(true)

  @@map("user_sessions")
  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@index([isActive])
  @@index([lastActivity])
}

// Tabela para rate limiting
model RateLimit {
  id          String   @id @default(cuid())
  identifier  String   // IP + User-Agent ou User ID
  action      String   // login, register, etc.
  attempts    Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@map("rate_limits")
  @@unique([identifier, action])
  @@index([identifier])
  @@index([action])
  @@index([expiresAt])
}