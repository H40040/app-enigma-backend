{
    "name": "enigma-crush-backend",
    "version": "1.0.0",
    "description": "Backend para o Enigma Crush",
    "main": "index.js",
    "scripts": {
        "start": "node index.js",
        "start:prod": "cross-env NODE_ENV=production node index.js",
        "dev": "nodemon index.js",
        "build": "npm run test && npm run db:migrate && echo 'Build completed'",
        "build:prod": "cross-env NODE_ENV=production npm run build && npm run db:deploy",
        "prisma:generate": "npx prisma generate",
        "migrate": "npx prisma migrate dev",
        "migrate:reset": "node prisma/migrations/fix_migrations.js",
        "cleanup": "node scripts/cleanup.js",
        "fix-env": "node scripts/fix-env.js",
        "fix-prisma": "node scripts/fix-prisma.js",
        "install:deps": "node scripts/install-deps.js",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "test": "jest --config jest.config.js",
        "test:coverage": "jest --config jest.config.js --coverage",
        "test:prod": "cross-env NODE_ENV=test npm run test:coverage",
        "test:integration": "cross-env NODE_ENV=test jest --config jest.config.js --testPathPattern=integration",
        "test:unit": "cross-env NODE_ENV=test jest --config jest.config.js --testPathPattern=unit",
        "test:watch": "jest --config jest.config.js --watch",
        "test:ci": "cross-env NODE_ENV=test jest --config jest.config.js --coverage --ci --watchAll=false",
        "db:setup": "node scripts/setup-postgresql.js",
        "db:generate": "npx prisma generate",
        "db:migrate": "npx prisma migrate deploy",
        "db:backup": "node -e \"require('./scripts/migrate-to-postgresql.js').backupSQLiteData()\"",
        "db:validate": "npx prisma migrate status && npx prisma validate",
        "db:studio": "npx prisma studio",
        "db:reset": "npx prisma migrate reset",
        "db:deploy": "npx prisma migrate deploy",
        "db:seed": "npx prisma db seed",
        "postinstall": "npx prisma generate",
        "health-check": "node scripts/health-check.js",
        "security-audit": "npm audit --audit-level moderate",
        "security-check": "npm audit && npm run lint",
        "docker:build": "docker build -t enigma-crush-backend .",
        "docker:run": "docker run -p 4006:4006 enigma-crush-backend",
        "docker:test": "docker build -t enigma-crush-backend:test . && docker run --rm enigma-crush-backend:test npm test",
        "performance:test": "artillery run artillery.yml",
        "performance:dev": "artillery run artillery.yml --environment development",
        "performance:prod": "artillery run artillery.yml --environment production",
        "ci:setup": "node scripts/setup-github-secrets.js all",
        "ci:secrets": "node scripts/setup-github-secrets.js secrets",
        "ci:validate": "node scripts/setup-github-secrets.js validate",
        "deploy:render": "echo 'Deploy será feito automaticamente via GitHub Actions'",
        "deploy:check": "curl -f $npm_config_backend_url/health || echo 'Backend não está respondendo'",
        "logs:render": "echo 'Acesse: https://dashboard.render.com para ver os logs'",
        "quality:check": "npm run lint && npm run security-audit && npm run test:coverage",
        "validate:production": "node scripts/validate-production.js",
        "validate:prod": "npm run validate:production",
        "precommit": "npm run lint:fix && npm run test",
        "prepare": "npx prisma generate"
    },
    "dependencies": {
        "@faker-js/faker": "^9.8.0",
        "@prisma/client": "^6.6.0",
        "apigratis-sdk-nodejs": "^0.1.6",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^2.4.3",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "cross-env": "^10.0.0",
        "csurf": "^1.11.0",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "hpp": "^0.2.3",
        "isomorphic-dompurify": "^2.26.0",
        "jsonwebtoken": "^9.0.1",
        "multer": "^1.4.5-lts.1",
        "supabase": "^2.39.2",
        "validator": "^13.15.15",
        "xss-clean": "^0.1.4"
    },
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.8.2"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.32.1",
        "@typescript-eslint/parser": "^8.32.1",
        "@vitest/coverage-v8": "^3.1.4",
        "eslint": "^9.27.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "prisma": "^6.6.0",
        "supertest": "^7.1.1"
    }
}
